{
  "//": "Admin content schemas. Read by app/schemas.py (validation) and the admin UI (forms). See README.",
  "sections": [
    {
      "key": "products",
      "label": "Products",
      "group": "Catalogue",
      "kind": "collection",
      "preview": "/products/{slug}",
      "idKey": "id",
      "titleKey": "name",
      "defaults": {
        "id": "$auto",
        "name": "",
        "slug": "",
        "status": "draft",
        "collections": [],
        "texture": "straight",
        "type": "bundle",
        "shade": "natural-black",
        "summary": "",
        "description": "",
        "details": [],
        "care": "",
        "variants": [
          {
            "length": 18,
            "price": 100,
            "compareAt": null,
            "stock": 0
          }
        ],
        "images": [],
        "bestseller": false,
        "allowPreorder": false,
        "badge": "New",
        "createdAt": "$today"
      },
      "fields": [
        {
          "type": "hidden",
          "key": "id"
        },
        {
          "type": "text",
          "key": "name",
          "label": "Product name",
          "required": true
        },
        {
          "type": "text",
          "key": "slug",
          "label": "URL slug",
          "required": true,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "help": "Used in the web address. Lowercase letters, numbers and dashes only. e.g. /products/honey-rebel-straight-bundle"
        },
        {
          "type": "select",
          "key": "status",
          "label": "Visibility",
          "options": [
            {
              "value": "active",
              "label": "Active — visible in the shop"
            },
            {
              "value": "draft",
              "label": "Draft — hidden while you work on it"
            },
            {
              "value": "archived",
              "label": "Archived — hidden, kept for records"
            }
          ]
        },
        {
          "type": "multiselect",
          "key": "collections",
          "label": "Collections",
          "optionsFrom": "collections"
        },
        {
          "type": "select",
          "key": "texture",
          "label": "Texture",
          "optionsFrom": "textures"
        },
        {
          "type": "select",
          "key": "type",
          "label": "Product type",
          "optionsFrom": "types"
        },
        {
          "type": "select",
          "key": "shade",
          "label": "Shade",
          "optionsFrom": "shades"
        },
        {
          "type": "images",
          "key": "images",
          "label": "Photos",
          "help": "First photo is the main one. Portrait (4:5) works best. Leave empty to show the branded placeholder."
        },
        {
          "type": "text",
          "key": "summary",
          "label": "Short summary",
          "help": "One line shown on cards and in Google results."
        },
        {
          "type": "textarea",
          "key": "description",
          "label": "Description",
          "rows": 5
        },
        {
          "type": "list",
          "key": "details",
          "label": "Details (bullet points)",
          "addLabel": "Add detail"
        },
        {
          "type": "textarea",
          "key": "care",
          "label": "Care instructions",
          "rows": 4
        },
        {
          "type": "repeater",
          "key": "variants",
          "label": "Lengths, prices & stock",
          "help": "One row per length. Prices are in your base currency. Set stock to 0 when a length sells out.",
          "itemLabel": "{length}\"",
          "addLabel": "Add length",
          "layout": "row",
          "fields": [
            {
              "type": "number",
              "key": "length",
              "label": "Length (inches)",
              "min": 1,
              "step": 1,
              "required": true
            },
            {
              "type": "number",
              "key": "price",
              "label": "Price",
              "min": 0,
              "step": 0.01,
              "required": true
            },
            {
              "type": "number",
              "key": "compareAt",
              "label": "\"Was\" price (optional)",
              "min": 0,
              "step": 0.01,
              "nullable": true
            },
            {
              "type": "number",
              "key": "stock",
              "label": "In stock",
              "min": 0,
              "step": 1
            }
          ]
        },
        {
          "type": "toggle",
          "key": "allowPreorder",
          "label": "Allow pre-orders when a length is out of stock"
        },
        {
          "type": "toggle",
          "key": "bestseller",
          "label": "Show in Home page bestsellers"
        },
        {
          "type": "text",
          "key": "badge",
          "label": "Badge",
          "help": "Small label on the product card, e.g. \"New\" or \"Bestseller\". Leave blank for none."
        },
        {
          "type": "hidden",
          "key": "createdAt"
        }
      ]
    },
    {
      "key": "shades",
      "label": "Shades",
      "group": "Catalogue",
      "kind": "collection",
      "preview": "/colour-guide#shade-{slug}",
      "idKey": "slug",
      "titleKey": "name",
      "defaults": {
        "slug": "",
        "number": "",
        "name": "",
        "family": "",
        "hook": "",
        "description": "",
        "undertoneLabel": "Neutral",
        "undertones": [
          "neutral"
        ],
        "depth": "Medium",
        "dimension": "soft",
        "bestFor": "",
        "swatch": {
          "base": "#3a2b22",
          "mid": "#6b4a32",
          "highlight": "#c99d62"
        },
        "product": "",
        "inGuide": true
      },
      "fields": [
        {
          "type": "text",
          "key": "name",
          "label": "Shade name",
          "required": true
        },
        {
          "type": "text",
          "key": "slug",
          "label": "URL slug",
          "required": true,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "help": "Used in the web address. Lowercase letters, numbers and dashes only. e.g. honey-rebel"
        },
        {
          "type": "text",
          "key": "number",
          "label": "Number",
          "help": "Shown as \"No. 01\"."
        },
        {
          "type": "text",
          "key": "family",
          "label": "Colour family",
          "help": "e.g. Bronde, Brunette, Blonde"
        },
        {
          "type": "text",
          "key": "hook",
          "label": "One-line hook (shown in italics)"
        },
        {
          "type": "textarea",
          "key": "description",
          "label": "Description (2 sentences)",
          "rows": 3
        },
        {
          "type": "text",
          "key": "undertoneLabel",
          "label": "Undertone (as shown)",
          "help": "e.g. Warm–neutral"
        },
        {
          "type": "multiselect",
          "key": "undertones",
          "label": "Undertone filters this shade appears under",
          "options": [
            {
              "value": "warm",
              "label": "Warm"
            },
            {
              "value": "cool",
              "label": "Cool"
            },
            {
              "value": "neutral",
              "label": "Neutral"
            }
          ]
        },
        {
          "type": "text",
          "key": "depth",
          "label": "Depth",
          "help": "e.g. Light, Medium, Deep"
        },
        {
          "type": "select",
          "key": "dimension",
          "label": "Dimension",
          "options": [
            {
              "value": "soft",
              "label": "Soft"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "high",
              "label": "High"
            }
          ]
        },
        {
          "type": "text",
          "key": "bestFor",
          "label": "Best suited to"
        },
        {
          "type": "group",
          "key": "swatch",
          "label": "Swatch colours",
          "help": "These paint the shade everywhere on the site until photos are added.",
          "layout": "row",
          "fields": [
            {
              "type": "color",
              "key": "base",
              "label": "Root / base"
            },
            {
              "type": "color",
              "key": "mid",
              "label": "Mid-lengths"
            },
            {
              "type": "color",
              "key": "highlight",
              "label": "Highlights / ends"
            }
          ]
        },
        {
          "type": "select",
          "key": "product",
          "label": "Hero product (where the shade links to)",
          "optionsFrom": "products"
        },
        {
          "type": "toggle",
          "key": "inGuide",
          "label": "Show in the Colour Guide shade grid"
        }
      ]
    },
