# ─────────────────────────────────────────────────────────────
# Stay Different Hair — environment variables
# Copy to .env.local for local development.
# ─────────────────────────────────────────────────────────────

# Password for the admin panel at /admin. REQUIRED in production
# (the admin is disabled if this is missing). In development it
# defaults to "admin" so you can get going quickly.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie. Use a long random
# string (e.g. `openssl rand -hex 32`). Falls back to a value derived
# from ADMIN_PASSWORD if omitted.
ADMIN_SECRET=

# Where the content store, uploads and form submissions are written.
# On Railway, mount a volume at /storage and set DATA_DIR=/storage.
DATA_DIR=./storage

# Public URL of the site — used for canonical URLs, sitemap and OG tags.
SITE_URL=http://localhost:3000
