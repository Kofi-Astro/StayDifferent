# ─────────────────────────────────────────────────────────────
# Stay Different Hair — environment variables
# Copy to .env (or set them in Railway → Variables).
# ─────────────────────────────────────────────────────────────

# Password for the admin panel at /admin. REQUIRED in production
# (the admin is switched off if this is missing). Locally it
# defaults to "admin" so you can get going quickly.
ADMIN_PASSWORD=change-me-to-something-long

# Secret used to sign the admin session cookie. Use a long random
# string, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=

# Where the content store, uploads and form submissions are written.
# On Railway, mount a volume at /storage and set DATA_DIR=/storage.
DATA_DIR=./storage

# Public URL of the site — used for canonical URLs, sitemap and OG tags.
SITE_URL=http://localhost:8000

# Set to "production" on the live server (secure cookies, admin password required).
ENV=development

# ── Optional: email "Forgot password?" links for the admin ────────
# Reset links go to ADMIN_EMAIL. Any SMTP provider works (Gmail app
# password, Zoho, Brevo, Mailgun, Resend…). Leave blank to disable;
# you can always reset by changing ADMIN_PASSWORD instead.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
